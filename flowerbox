
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>3D FlowerBox</title>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js"
  }
}
</script>

<style>
* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000;
  font-family: Arial, sans-serif;
}

#flowerbox {
  position: fixed;
  inset: 0;
  cursor: grab;
  touch-action: none;
}

#flowerbox:active {
  cursor: grabbing;
}

canvas {
  display: block;
}

#label {
  position: fixed;
  left: 24px;
  bottom: 22px;
  color: rgba(255,255,255,.55);
  font-size: 11px;
  letter-spacing: 3px;
  pointer-events: none;
  text-transform: uppercase;
}

#hint {
  position: fixed;
  right: 24px;
  bottom: 22px;
  color: rgba(255,255,255,.35);
  font-size: 11px;
  letter-spacing: 1px;
  pointer-events: none;
}
</style>
</head>

<body>

<div id="flowerbox"></div>

<div id="label">
  3D FlowerBox · Windows XP
</div>

<div id="hint">
  DRAG TO ROTATE
</div>

<script type="module">

import * as THREE from 'three';

// =====================================
// SCENE SETUP
// =====================================

const container = document.getElementById('flowerbox');

const scene = new THREE.Scene();

scene.background = new THREE.Color(0x000000);

const camera = new THREE.PerspectiveCamera(
  45,
  window.innerWidth / window.innerHeight,
  0.1,
  100
);

camera.position.set(0, 0, 8);

const renderer = new THREE.WebGLRenderer({
  antialias: true,
  powerPreference: 'high-performance'
});

renderer.setSize(
  window.innerWidth,
  window.innerHeight
);

renderer.setPixelRatio(
  Math.min(window.devicePixelRatio, 2)
);

renderer.outputColorSpace = THREE.SRGBColorSpace;

container.appendChild(renderer.domElement);


// =====================================
// LIGHTING
// =====================================

scene.add(
  new THREE.AmbientLight(0xffffff, 1.3)
);

const keyLight = new THREE.DirectionalLight(
  0xffffff,
  3
);

keyLight.position.set(4, 5, 6);
scene.add(keyLight);

const fillLight = new THREE.PointLight(
  0x4488ff,
  35
);

fillLight.position.set(-4, -2, 3);
scene.add(fillLight);

const rimLight = new THREE.PointLight(
  0xff4488,
  30
);

rimLight.position.set(2, 3, -4);
scene.add(rimLight);


// =====================================
// FLOWERBOX GROUP
// =====================================

const flowerbox = new THREE.Group();

scene.add(flowerbox);


// =====================================
// COLORS
// =====================================

const colors = [
  0xff1744,
  0xffd600,
  0x00e676,
  0x00b0ff,
  0xd500f9,
  0xff6d00
];


// =====================================
// CREATE PETAL GEOMETRY
// =====================================

function createPetal(color) {

  const geometry = new THREE.BufferGeometry();

  const positions = [];
  const indices = [];

  const rows = 24;
  const columns = 16;

  const length = 1.45;

  for (let i = 0; i <= rows; i++) {

    const t = i / rows;

    for (let j = 0; j <= columns; j++) {

      const u = (j / columns) * 2 - 1;

      const width =
        Math.pow(Math.sin(t * Math.PI), 0.65) * 0.58;

      const x = u * width;
      const y = t * length;

      const z =
        Math.sin(t * Math.PI) *
        (1 - u * u) *
        0.18;

      positions.push(x, y, z);
    }
  }

  for (let i = 0; i < rows; i++) {

    for (let j = 0; j < columns; j++) {

      const a = i * (columns + 1) + j;
      const b = a + columns + 1;

      indices.push(a, b, a + 1);
      indices.push(b, b + 1, a + 1);
    }
  }

  geometry.setAttribute(
    'position',
    new THREE.Float32BufferAttribute(
      positions,
      3
    )
  );

  geometry.setIndex(indices);

  geometry.computeVertexNormals();

  const material = new THREE.MeshStandardMaterial({

    color: color,

    metalness: 0.65,

    roughness: 0.24,

    side: THREE.DoubleSide

  });

  const petal = new THREE.Mesh(
    geometry,
    material
  );

  return petal;
}


// =====================================
// CREATE SIX PETALS
// =====================================

const directions = [

  new THREE.Vector3(0, 1, 0),

  new THREE.Vector3(0, -1, 0),

  new THREE.Vector3(1, 0, 0),

  new THREE.Vector3(-1, 0, 0),

  new THREE.Vector3(0, 0, 1),

  new THREE.Vector3(0, 0, -1)

];

const petals = [];

directions.forEach((direction, index) => {

  const group = new THREE.Group();

  const petal = createPetal(colors[index]);

  group.add(petal);

  group.quaternion.setFromUnitVectors(
    new THREE.Vector3(0, 1, 0),
    direction
  );

  flowerbox.add(group);

  petals.push({

    group,
    petal,
    index,
    direction

  });

});


// =====================================
// CENTRAL CORE
// =====================================

const coreGeometry =
  new THREE.IcosahedronGeometry(0.32, 1);

const coreMaterial =
  new THREE.MeshStandardMaterial({

    color: 0xffffff,

    metalness: 0.8,

    roughness: 0.18

  });

const core = new THREE.Mesh(
  coreGeometry,
  coreMaterial
);

flowerbox.add(core);


// =====================================
// MORPHING SYSTEM
// ROUND <-> POINTY
// =====================================

let morph = 0;

function updateMorph(time) {

  // Smooth repeating morph cycle.
  // 0 = pointy
  // 1 = round

  morph = (Math.sin(time * 0.8) + 1) / 2;

  petals.forEach((item) => {

    const { petal } = item;

    const position =
      petal.geometry.attributes.position;

    const rows = 24;
    const columns = 16;

    for (let i = 0; i <= rows; i++) {

      const t = i / rows;

      for (let j = 0; j <= columns; j++) {

        const u = (j / columns) * 2 - 1;

        const vertex =
          i * (columns + 1) + j;

        // Pointy profile
        const pointWidth =
          Math.pow(
            Math.sin(t * Math.PI),
            2.8
          ) * 0.58;

        // Rounded profile
        const roundWidth =
          Math.pow(
            Math.sin(t * Math.PI),
            0.65
          ) * 0.58;

        // Interpolate between shapes
        const width = THREE.MathUtils.lerp(
          pointWidth,
          roundWidth,
          morph
        );

        const x = u * width;

        const y = t * 1.45;

        // Surface curvature also changes
        // during the morph.

        const z =
          Math.sin(t * Math.PI) *
          (1 - u * u) *
          THREE.MathUtils.lerp(
            0.55,
            0.18,
            morph
          );

        position.setXYZ(
          vertex,
          x,
          y,
          z
        );

      }

    }

    position.needsUpdate = true;

    petal.geometry.computeVertexNormals();

  });

}


// =====================================
// DRAG CONTROLS
// =====================================

let dragging = false;

let previousX = 0;
let previousY = 0;

let velocityX = 0;
let velocityY = 0;

container.addEventListener(
  'pointerdown',
  (event) => {

    dragging = true;

    previousX = event.clientX;
    previousY = event.clientY;

    velocityX = 0;
    velocityY = 0;

    container.setPointerCapture(
      event.pointerId
    );

  }
);

container.addEventListener(
  'pointermove',
  (event) => {

    if (!dragging) return;

    const deltaX =
      event.clientX - previousX;

    const deltaY =
      event.clientY - previousY;

    velocityY = deltaX * 0.008;

    velocityX = deltaY * 0.008;

    flowerbox.rotation.y += velocityY;

    flowerbox.rotation.x += velocityX;

    previousX = event.clientX;
    previousY = event.clientY;

  }
);

container.addEventListener(
  'pointerup',
  () => {

    dragging = false;

  }
);

container.addEventListener(
  'pointercancel',
  () => {

    dragging = false;

  }
);


// =====================================
// ANIMATION
// =====================================

const clock = new THREE.Clock();

function animate() {

  requestAnimationFrame(animate);

  const delta = Math.min(
    clock.getDelta(),
    0.05
  );

  const time = clock.elapsedTime;


  // Update geometry morphing

  updateMorph(time);


  // Automatic rotation and inertia

  if (!dragging) {

    flowerbox.rotation.y +=
      velocityY + delta * 0.12;

    flowerbox.rotation.x +=
      velocityX + delta * 0.06;

    velocityX *=
      Math.pow(0.94, delta * 60);

    velocityY *=
      Math.pow(0.94, delta * 60);

  }


  // Floating movement

  flowerbox.position.y =
    Math.sin(time * 0.7) * 0.35;

  flowerbox.position.x =
    Math.sin(time * 0.4) * 0.3;


  // Gentle pulsing

  const pulse =
    1 + Math.sin(time * 1.1) * 0.035;

  flowerbox.scale.setScalar(pulse);


  // Color cycling

  petals.forEach((item) => {

    const hue =
      (
        item.index / petals.length +
        time * 0.035
      ) % 1;

    item.petal.material.color.setHSL(
      hue,
      0.9,
      0.55
    );

  });


  // Render

  renderer.render(scene, camera);

}

animate();


// =====================================
// RESPONSIVE RESIZING
// =====================================

window.addEventListener(
  'resize',
  () => {

    camera.aspect =
      window.innerWidth / window.innerHeight;

    camera.updateProjectionMatrix();

    renderer.setSize(
      window.innerWidth,
      window.innerHeight
    );

    renderer.setPixelRatio(
      Math.min(window.devicePixelRatio, 2)
    );

  }
);

</script>

</body>
</html>
